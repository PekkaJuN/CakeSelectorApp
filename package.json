{
  "name": "cake-selector-app",
  "version": "0.1.0",
  "description": "Simple product and order management web application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test 'tests/**/*.test.js'",
