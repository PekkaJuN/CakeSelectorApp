# Cake Recommender Agent configuration

# Optional: Gemini API key for narration/wording (not required for core logic)
# GEMINI_API_KEY=your-key-here

# Optional: Override default Gemini model
# GEMINI_MODEL=gemini-2.0-flash

# Optional: Database URL if using real database instead of mock
# DATABASE_URL=postgresql://user:pass@localhost/cakes
